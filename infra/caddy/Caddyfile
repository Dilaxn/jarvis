# Automatic HTTPS for every site below (Let's Encrypt, auto-renewed).

{
	email admin@dilax.space
}

(common) {
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}
}

lankanews.click, www.lankanews.click {
	import common
	reverse_proxy lanka-news:3001
}

lankanews.dilax.space {
	import common
	reverse_proxy lanka-news:3001
}

invitebloom.online, www.invitebloom.online {
	import common
	reverse_proxy invitation:3002
}

invite.dilax.space {
	import common
	reverse_proxy invitation:3002
}

pms.dilax.space {
	import common
	reverse_proxy pms:3003
}

prince.dilax.space {
	import common
	reverse_proxy prince:3004
}

webpulse.dilax.space {
	import common
	reverse_proxy webpulse:3005
}

# Management dashboard — no IP lock for now, protected by login only.
